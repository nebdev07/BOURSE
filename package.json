{
  "name": "brvm-investment-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BRVM Investment Analyzer — MVP hexagonal / DDD",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register-loader.mjs src/infrastructure/seed/run-seed.ts",
    "db:setup": "node scripts/setup-postgres.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@prisma/client": "^6.14.0",
    "next": "^15.5.0",
    "nodemailer": "^7.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
