# Runtime
NODE_ENV=production

# Persistence: "file" (tests) | "pglite" | "mysql" (prod recommandé)
PERSISTENCE_DRIVER=mysql

# MySQL — utilisateur applicatif dédié (PAS root en production)
# Créer avec: npm run db:create-app-user
DATABASE_URL=mysql://brvm_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/db_bourse

# Dev Laragon uniquement (mot de passe vide) :
# DATABASE_URL=mysql://root@127.0.0.1:3306/db_bourse

# Admin
ADMIN_EMAIL=you@example.com

# Exemple portefeuille prérempli (données perso) — OFF en prod
ENABLE_ADMIN_PORTFOLIO_EXAMPLE=0

# Email (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=brvm-analyzer@localhost
ALERT_EMAIL_TO=

# Jobs — générer: openssl rand -hex 32
JOB_SECRET=CHANGE_ME_openssl_rand_hex_32

# Rafraîchissement marché (ms). Défaut 1 h.
MARKET_REFRESH_MS=3600000
# MARKET_REFRESH_DISABLED=1
INGEST_HOUR_LOCAL=18
