# Runtime
NODE_ENV=development

# Persistence: "file" | "pglite" (PostgreSQL WASM local) | "prisma" (PostgreSQL serveur)
PERSISTENCE_DRIVER=pglite

# PostgreSQL serveur — si postgres.exe est autorisé / instance distante
# DATABASE_URL=postgresql://postgres:brvm_local@127.0.0.1:5432/brvm_analyzer?schema=public

# Premier e-mail promu admin (en plus du premier compte créé)
ADMIN_EMAIL=

# Email (Phase 12) — laisser vide pour log-only en local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=brvm-analyzer@localhost
ALERT_EMAIL_TO=

# Jobs
JOB_SECRET=change-me-in-production
INGEST_HOUR_LOCAL=18
